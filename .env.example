# App
APP_URL=http://localhost:8080
APP_ENV=local

# OpenAI (required for chat + images)
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=chatgpt-image-latest
OPENAI_MAX_TOKENS=150
OPENAI_TEMPERATURE=0.8

# MySQL
CARDOBOT_DB_HOST=127.0.0.1
CARDOBOT_DB_NAME=cardobot
CARDOBOT_DB_USER=cardobot
CARDOBOT_DB_PASS=
CARDOBOT_DB_CHARSET=utf8mb4

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploads (Railway volume recommended)
UPLOAD_ROOT=

# ML sidecar (optional; leave blank to disable)
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
ML_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
